# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# Deployed apps: the deployer injects these per-app.
GROK_AUTH_ISSUER=https://auth.grok.me
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
# Optional: shared live-preview client secret for *.grok-sandbox.com previews.
GROK_PREVIEW_CLIENT_SECRET=
BETTER_AUTH_URL=
